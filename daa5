#include <iostream>
#include <vector>
using namespace std;

// Can we place a queen at (row, col)?
bool isSafe(vector<vector<int>>& board, int row, int col, int n) {
    for (int i = 0; i < row; i++)                           // same column
        if (board[i][col]) return false;

    for (int i = row - 1, j = col - 1; i >= 0 && j >= 0; i--, j--)   // upper-left
        if (board[i][j]) return false;

    for (int i = row - 1, j = col + 1; i >= 0 && j < n; i--, j++)    // upper-right
        if (board[i][j]) return false;

    return true;
}

bool solve(vector<vector<int>>& board, int row, int n) {
    if (row == n) return true;                              // all queens placed

    for (int col = 0; col < n; col++) {
        if (isSafe(board, row, col, n)) {
            board[row][col] = 1;                            // place
            if (solve(board, row + 1, n)) return true;      // go deeper
            board[row][col] = 0;                            // backtrack
        }
    }
    return false;                                           // no column works in this row
}

int main() {
    int n, firstCol;
    cout << "Enter n: ";
    cin >> n;
    cout << "Enter column (0 to " << n - 1 << ") for the first queen in row 0: ";
    cin >> firstCol;

    vector<vector<int>> board(n, vector<int>(n, 0));
    board[0][firstCol] = 1;                                 // first queen is fixed

    if (solve(board, 1, n)) {                               // start from row 1
        cout << "\nFinal N-Queens matrix:\n";
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++)
                cout << (board[i][j] ? "Q " : ". ");
            cout << endl;
        }
    } else {
        cout << "No solution exists with the first queen at that position.\n";
    }
    return 0;
}
