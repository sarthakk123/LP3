#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    int n, W;
    cout << "Enter number of items: ";
    cin >> n;
    vector<int> wt(n + 1), val(n + 1);
    cout << "Enter weight and value of each item:\n";
    for (int i = 1; i <= n; i++) cin >> wt[i] >> val[i];
    cout << "Enter knapsack capacity: ";
    cin >> W;

    // dp[i][w] = best value using first i items with capacity w
    vector<vector<int>> dp(n + 1, vector<int>(W + 1, 0));

    for (int i = 1; i <= n; i++) {
        for (int w = 0; w <= W; w++) {
            dp[i][w] = dp[i - 1][w];                         // skip item i
            if (wt[i] <= w)                                  // take item i
                dp[i][w] = max(dp[i][w], val[i] + dp[i - 1][w - wt[i]]);
        }
    }

    cout << "Maximum value = " << dp[n][W] << endl;

    // Trace back to find chosen items
    cout << "Items selected: ";
    int w = W;
    for (int i = n; i >= 1; i--) {
        if (dp[i][w] != dp[i - 1][w]) {                      // item i was taken
            cout << i << " ";
            w -= wt[i];
        }
    }
    cout << endl;
    return 0;
}
